---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	rewrite_query_node(rewrite_query_node)
	select_tool_node(select_tool_node)
	tool_node(tool_node)
	generate_node(generate_node)
	__end__([<p>__end__</p>]):::last
	__start__ -.-> generate_node;
	__start__ -.-> rewrite_query_node;
	__start__ -.-> select_tool_node;
	rewrite_query_node --> select_tool_node;
	select_tool_node --> tool_node;
	tool_node --> generate_node;
	generate_node --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
